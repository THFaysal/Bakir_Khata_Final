# SAMPLE ONLY - do not commit actual credentials.
# IntelliJ: copy values into Run/Debug Configuration > Environment variables.
# Render: set values in Environment. Plain .env files are NOT automatically loaded by Spring.
SPRING_PROFILES_ACTIVE=prod
PORT=10000
SECURE_COOKIE=true

# Step 1: Aiven MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/bakir_khata?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=YOUR_MYSQL_APP_USER
SPRING_DATASOURCE_PASSWORD=YOUR_MYSQL_PASSWORD
# Base64 of Aiven's downloaded CA PEM certificate. Used by Docker start-server.sh.
AIVEN_CA_CERT_BASE64=BASE64_OF_AIVEN_CA_PEM

# Step 2: MongoDB Atlas
MONGODB_URI=mongodb+srv://YOUR_MONGO_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/bakir_messenger?retryWrites=true&w=majority

# Step 3: Cloudinary (choose either URL or separate values)
CLOUDINARY_URL=cloudinary://YOUR_KEY:YOUR_SECRET@YOUR_CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
# CLOUDINARY_API_KEY=YOUR_KEY
# CLOUDINARY_API_SECRET=YOUR_SECRET

# Step 4: Domain and HTTPS (update after Render custom domain setup)
APP_PUBLIC_BASE_URL=https://app.yourdomain.com
APP_JWT_SECRET=BASE64_ENCODED_RANDOM_32_BYTES_OR_MORE
APP_RECEIPT_SECRET=INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Step 5: Email and SMS verification
EMAIL_MODE=resend
EMAIL_FROM=no-reply@notify.yourdomain.com
RESEND_API_KEY=YOUR_RESEND_API_KEY
OTP_MODE=twilio
OTP_FALLBACK_TO_DEMO=false
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=YOUR_TWILIO_VERIFY_SERVICE_SID

# Step 6: Payment sandbox ONLY (no live payment credentials)
PAYMENT_MODE=sandbox
SSLCOMMERZ_SANDBOX_STORE_ID=YOUR_SANDBOX_STORE_ID
SSLCOMMERZ_SANDBOX_STORE_PASSWORD=YOUR_SANDBOX_STORE_PASSWORD

# Optional one-time admin bootstrap (remove password after initial provisioning)
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_PHONE=+8801700000000
APP_ADMIN_PASSWORD=YOUR_STRONG_TEMPORARY_ADMIN_PASSWORD
DDL_AUTO=update
THYMELEAF_CACHE=true
